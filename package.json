{
  "name": "dsh-plugin-whale-soulmate",
  "version": "0.2.136",
  "description": "Modular, pluggable AI companion (Soulmate) for DeepSeek Harness: persona + LLM Wiki memory + five-layer privacy firewall + desktop pet + AIGC cloud sync.",
  "type": "module",
  "main": "index.js",
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "packages/",
    "runtime/",
    "assets/pet-winterboy-chibi/",
    "assets/pet-hanfu/",
    "assets/小鲸.png",
    "assets/小鲸-male.jpg",
    "README.md",
    "LICENSE",
    "NOTICE.md",
    "docs/readme-banner-v2.png",
    "docs/DESIGN.md"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build:client": "node browser/build.mjs",
    "prepare": "node browser/build.mjs",
    "pretest": "node browser/build.mjs",
    "test": "node --test test/*.test.mjs",
    "prepack": "node browser/build.mjs",
    "preview": "node server-mock/preview-server.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JasperGuWP/dsh-plugin-whale-soulmate.git"
  },
  "bugs": {
    "url": "https://github.com/JasperGuWP/dsh-plugin-whale-soulmate/issues"
  },
  "homepage": "https://github.com/JasperGuWP/dsh-plugin-whale-soulmate#readme",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "soulmate",
    "memory",
    "desktop-pet"
  ],
  "author": "JasperGuWP",
  "license": "MIT",
  "dependencies": {
    "qrcode": "^1.5.4"
  }
}
